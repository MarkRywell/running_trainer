<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch splash for Android 11 and below, API 21+.

  Identical to the drawable/ version. Flutter's template keeps a -v21 copy
  because older platforms lack some attributes; the layer-list here does not use
  any of them, so the two must stay in step. Change both together.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
